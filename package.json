{
  "name": "esf-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "seed:bulletins": "sanity exec scripts/seed-bulletins.ts --with-user-token",
    "seed:content": "sanity exec scripts/seed-content.ts --with-user-token",
    "upload:hero-video": "sanity exec scripts/upload-hero-video.ts --with-user-token --",
    "migrate:mission-statement": "sanity exec scripts/migrate-mission-statement.ts --with-user-token",
    "sanity:schema": "sanity schemas extract --enforce-required-fields --force",
    "sanity:typegen": "npm run sanity:schema && sanity typegen generate"
  },
  "dependencies": {
    "@portabletext/react": "^7.0.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.11.0",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "next": "16.3.1",
    "next-sanity": "^13.3.3",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-pdf": "^10.5.0",
    "resend": "^6.25.0",
    "sanity": "^6.11.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
