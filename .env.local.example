# Create a free project at https://sanity.io/manage (or run `npx sanity init`
# from this folder) then fill these in. Until they're set, the site builds
# and runs fine — /studio shows a "not configured" message and the bulletin
# lists render empty.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Sanity project → API → Webhooks → create one, generate a secret, paste it
# here and in the webhook config. Used to verify /api/revalidate requests.
SANITY_REVALIDATE_SECRET=

# Contact form email delivery — sign up at https://resend.com (or via
# `vercel integration add resend`), verify a sending domain, then paste the
# API key below. Until set, /api/contact returns a friendly "not configured"
# error instead of failing silently.
RESEND_API_KEY=
# Optional overrides — default to org.email from lib/content.ts and Resend's
# shared test sender respectively.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Contact form submission storage — private Sanity dataset, kept separate
# from "production" because that one is public-read (see lib/sanity/client.ts)
# and submissions carry visitor PII. Create it with:
#   npx sanity dataset create internal --visibility private
# then create an API token (write access) at https://sanity.io/manage and
# paste it below. Until set, submissions are emailed but not persisted.
SANITY_INTERNAL_TOKEN=

# Contact form bot protection — register the production domain (and
# "localhost" for local testing) as a reCAPTCHA v3 site at
# https://www.google.com/recaptcha/admin, then paste the two keys below.
# Until set, the form still works but skips reCAPTCHA verification entirely.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
