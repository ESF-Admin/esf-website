# Create a free project at https://sanity.io/manage (or run `npx sanity init`
# from this folder) then fill these in. Until they're set, the site builds
# and runs fine — /studio shows a "not configured" message and the bulletin
# lists render empty.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Sanity project → API → Webhooks → create one, generate a secret, paste it
# here and in the webhook config. Used to verify /api/revalidate requests.
SANITY_REVALIDATE_SECRET=

# Contact form email delivery — sign up at https://resend.com (or via
# `vercel integration add resend`), verify a sending domain, then paste the
# API key below. Until set, /api/contact returns a friendly "not configured"
# error instead of failing silently.
RESEND_API_KEY=
# Optional overrides — default to org.email from lib/content.ts and Resend's
# shared test sender respectively.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
